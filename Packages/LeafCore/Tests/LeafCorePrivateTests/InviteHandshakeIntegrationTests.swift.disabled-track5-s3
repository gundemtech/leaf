    // MARK: - 1

    func testAdminGenerate_RealKDF_RealCodec_RoundTripsPlaintextLocally() async throws {
        stub201Counter("tok_")
        let kdf = CapturingProdInviteKDF()
        let codec = ProdInviteBlobCodec()
        let svc = makeService(kdf: kdf, codec: codec)

        let invitee = String(repeating: "a", count: 64)
        _ = try await svc.generateInvite(workspaceID: orgID, inviteePubkeyHex: invitee)

        // Capture the blob from URLProtocol body — base64url-decoded.
        let body = try XCTUnwrap(HandshakeMockURLProtocol.lastBody)
        let json = try XCTUnwrap(JSONSerialization.jsonObject(with: body) as? [String: Any])
        let blobB64 = try XCTUnwrap(json["blob"] as? String)
        let blobBytes = try XCTUnwrap(Data(base64URLNoPad: blobB64))
        let blob = InviteBlob(bytes: blobBytes)

        // Decode locally with same wrapKey.
        let wrapKey = try XCTUnwrap(kdf.captured)
        let decoded = try codec.decode(blob, wrapKey: wrapKey)

        XCTAssertEqual(decoded.teamKeyBase64, teamKeyBytes.base64EncodedString())
        XCTAssertEqual(decoded.teamKeyID, teamKeyID)
        XCTAssertEqual(decoded.orgID, orgID)
        XCTAssertEqual(decoded.orgName, "Org")
        XCTAssertEqual(decoded.adminMemberID, memberID)
        XCTAssertEqual(decoded.adminDisplayName, "Admin")
        XCTAssertEqual(decoded.issuedAtMs, Int64(fixedNow.timeIntervalSince1970 * 1000))
    }

