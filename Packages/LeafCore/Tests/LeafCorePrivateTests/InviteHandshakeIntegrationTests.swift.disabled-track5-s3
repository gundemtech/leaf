    // MARK: - 6 — full admin↔invitee E2E handshake (Phase 5.2.E)

    /// Stub relay that routes by HTTP method:
    /// POST → captures blob from request JSON body, returns 201 with token.
    /// GET  → returns 200 with previously-captured blob bytes.
    private func stubRelayHandshake(token: String, expiresAtMs: Int64,
                                     storage: BlobStorage) {
        HandshakeMockURLProtocol.handler = { req, body in
            switch req.httpMethod {
            case "POST":
                guard let json = try JSONSerialization.jsonObject(with: body) as? [String: Any],
                      let blobB64 = json["blob"] as? String,
                      let blobBytes = Data(base64URLNoPad: blobB64) else {
                    throw URLError(.badServerResponse)
                }
                storage.set(blobBytes)
                let respBody = """
                {"token":"\(token)","expires_at_ms":\(expiresAtMs)}
                """.data(using: .utf8)!
                let resp = HTTPURLResponse(url: req.url!, statusCode: 201, httpVersion: nil,
                                            headerFields: ["Content-Type": "application/json"])!
                return (resp, respBody)
            case "GET":
                guard let blobBytes = storage.get() else {
                    let resp = HTTPURLResponse(url: req.url!, statusCode: 404, httpVersion: nil,
                                                headerFields: nil)!
                    return (resp, nil)
                }
                let respBody = """
                {"blob":"\(blobBytes.base64URLNoPad)","expires_at_ms":\(expiresAtMs)}
                """.data(using: .utf8)!
                let resp = HTTPURLResponse(url: req.url!, statusCode: 200, httpVersion: nil,
                                            headerFields: ["Content-Type": "application/json"])!
                return (resp, respBody)
            default:
                throw URLError(.badServerResponse)
            }
        }
    }

    private final class BlobStorage: @unchecked Sendable {
        private let lock = NSLock()
        private var bytes: Data?
        func set(_ data: Data) { lock.lock(); defer { lock.unlock() }; bytes = data }
        func get() -> Data? { lock.lock(); defer { lock.unlock() }; return bytes }
    }

    /// Setup an invitee-side fresh tempDir + DB + keystore with given priv.
    /// Returns (db, keystoreRoot, tempDir).
    private func makeInviteeSide(priv: Curve25519.KeyAgreement.PrivateKey) throws
        -> (Database, URL, URL) {
        let dir = FileManager.default.temporaryDirectory
            .appendingPathComponent("invitee-\(UUID().uuidString)", isDirectory: true)
        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
        let dbURL = dir.appendingPathComponent("events.sqlite")
        let ksRoot = dir.appendingPathComponent("keystore", isDirectory: true)
        let db = try Database.openForWrite(at: dbURL, config: .weakDefaults,
                                           encryption: .deterministicTest)
        try TeamKeystore.writeX25519Private(priv.rawRepresentation, at: ksRoot)
        return (db, ksRoot, dir)
    }

    private func makeInviteeAcceptService(db: Database, ksRoot: URL,
                                           priv: Curve25519.KeyAgreement.PrivateKey,
                                           nowMs: Int64 = 1_700_010_000_000)
        -> InviteAcceptService {
        InviteAcceptService(
            database: db,
            relayClient: makeRelayClient(),
            inviteKDF: ProdInviteKDF(),
            inviteBlobCodec: ProdInviteBlobCodec(),
            keystoreRoot: ksRoot,
            now: { Date(timeIntervalSince1970: TimeInterval(nowMs) / 1000) },
            identity: { priv },
            generateMemberID: { "22222222-2222-4222-8222-222222222222" }
        )
    }

    func testFullHandshake_AdminGenerates_InviteeAccepts_BothHaveMatchingTeamKey() async throws {
        let storage = BlobStorage()
        stubRelayHandshake(token: "tok_e2e_1", expiresAtMs: 1_700_086_400_000, storage: storage)

        // Admin side: generate invite through real crypto.
        let inviteePriv = Curve25519.KeyAgreement.PrivateKey()
        let inviteePubHex = inviteePriv.publicKey.rawRepresentation
            .map { String(format: "%02x", $0) }.joined()
        let adminSvc = makeService(kdf: ProdInviteKDF(), codec: ProdInviteBlobCodec(),
                                    otp: "654321")
        let outbound = try await adminSvc.generateInvite(workspaceID: orgID, inviteePubkeyHex: inviteePubHex)

        // Invitee side: fresh DB + keystore + service.
        let (inviteeDB, ksRoot, inviteeDir) = try makeInviteeSide(priv: inviteePriv)
        defer { try? FileManager.default.removeItem(at: inviteeDir) }
        let inviteeSvc = makeInviteeAcceptService(db: inviteeDB, ksRoot: ksRoot,
                                                   priv: inviteePriv)

        // Fetch through stub GET → accept with correct OTP.
        let blob = try await inviteeSvc.fetchInvite(token: outbound.token)
        let accepted = try await inviteeSvc.acceptInvite(blob: blob,
                                                         otp: outbound.otp ?? "",
                                                         displayName: "Bob")

        // Assert invitee DB matches admin-issued metadata.
        XCTAssertEqual(accepted.orgID, orgID)
        XCTAssertEqual(accepted.orgName, "Org")
        XCTAssertEqual(accepted.teamKeyID, teamKeyID)
        XCTAssertEqual(accepted.selfMemberID, "22222222-2222-4222-8222-222222222222")

        let inviteeOrg = try XCTUnwrap(inviteeDB.listWorkspaces(includeLeft: true).first)
        XCTAssertEqual(inviteeOrg.id, orgID)

        let inviteeMembers = try inviteeDB.readTeamMembers(workspaceID: orgID)
        XCTAssertEqual(inviteeMembers.count, 2)
        XCTAssertNotNil(inviteeMembers.first(where: { $0.id == memberID && $0.role == .admin }))
        XCTAssertNotNil(inviteeMembers.first(where: { $0.id == accepted.selfMemberID && $0.role == .member && $0.displayName == "Bob" }))

        let inviteeKey = try XCTUnwrap(inviteeDB.readActiveTeamKey(workspaceID: orgID))
        XCTAssertEqual(inviteeKey.id, teamKeyID)

        // Critical: matching teamKey bytes on both devices (the moat invariant).
        // Track-5 S2: keystore reads use workspace-scoped sub-folder path.
        let inviteeTeamKeyBytes = try TeamKeystore.readTeamKey(workspaceID: orgID,
                                                               keyID: teamKeyID,
                                                               at: ksRoot)
        XCTAssertEqual(inviteeTeamKeyBytes, teamKeyBytes,
                       "invitee teamKey must equal admin teamKey bytes after handshake")
    }

    func testFullHandshake_WrongOTP_LeavesInviteeDBUntouched() async throws {
        let storage = BlobStorage()
        stubRelayHandshake(token: "tok_e2e_2", expiresAtMs: 1_700_086_400_000, storage: storage)

        let inviteePriv = Curve25519.KeyAgreement.PrivateKey()
        let inviteePubHex = inviteePriv.publicKey.rawRepresentation
            .map { String(format: "%02x", $0) }.joined()
        let adminSvc = makeService(kdf: ProdInviteKDF(), codec: ProdInviteBlobCodec(),
                                    otp: "111111")
        let outbound = try await adminSvc.generateInvite(workspaceID: orgID, inviteePubkeyHex: inviteePubHex)

        let (inviteeDB, ksRoot, inviteeDir) = try makeInviteeSide(priv: inviteePriv)
        defer { try? FileManager.default.removeItem(at: inviteeDir) }
        let inviteeSvc = makeInviteeAcceptService(db: inviteeDB, ksRoot: ksRoot,
                                                   priv: inviteePriv)

        let blob = try await inviteeSvc.fetchInvite(token: outbound.token)
        do {
            _ = try await inviteeSvc.acceptInvite(blob: blob, otp: "999999", displayName: "Bob")
            XCTFail("expected inviteOTPInvalid")
        } catch LeafError.inviteOTPInvalid {
            // ok
        }

        XCTAssertNil(try inviteeDB.listWorkspaces(includeLeft: true).first)
        XCTAssertEqual(try inviteeDB.readTeamMembers(workspaceID: orgID).count, 0)
        XCTAssertNil(try inviteeDB.readActiveTeamKey(workspaceID: orgID))
        // No teamKey file written to invitee keystore (workspace-scoped path).
        XCTAssertThrowsError(try TeamKeystore.readTeamKey(workspaceID: orgID,
                                                          keyID: teamKeyID,
                                                          at: ksRoot))
    }

    func testFullHandshake_InviteeWithExistingWorkspace_RefusesAccept() async throws {
        // Track-5 S2: multi-workspace, so refusal triggers only when the
        // invitee already has an *active* membership in the *same* workspace
        // the invite points at (not any arbitrary other workspace).
        let storage = BlobStorage()
        stubRelayHandshake(token: "tok_e2e_3", expiresAtMs: 1_700_086_400_000, storage: storage)

        let inviteePriv = Curve25519.KeyAgreement.PrivateKey()
        let inviteePubHex = inviteePriv.publicKey.rawRepresentation
            .map { String(format: "%02x", $0) }.joined()
        let adminSvc = makeService(kdf: ProdInviteKDF(), codec: ProdInviteBlobCodec(),
                                    otp: "222222")
        let outbound = try await adminSvc.generateInvite(workspaceID: orgID, inviteePubkeyHex: inviteePubHex)

        let (inviteeDB, ksRoot, inviteeDir) = try makeInviteeSide(priv: inviteePriv)
        defer { try? FileManager.default.removeItem(at: inviteeDir) }
        // Pre-seed invitee DB with the SAME workspace id the admin issued
        // the invite for (left_at_ms == nil → active membership).
        try inviteeDB.upsertWorkspace(Workspace(id: orgID, name: "Already Mine",
                                     createdAt: Date(timeIntervalSince1970: 1_699_000_000),
                                     createdByMemberID: UUID().uuidString.lowercased()))

        let inviteeSvc = makeInviteeAcceptService(db: inviteeDB, ksRoot: ksRoot,
                                                   priv: inviteePriv)

        let blob = try await inviteeSvc.fetchInvite(token: outbound.token)
        do {
            _ = try await inviteeSvc.acceptInvite(blob: blob, otp: outbound.otp ?? "",
                                                  displayName: "Bob")
            XCTFail("expected inviteAlreadyAccepted")
        } catch LeafError.inviteAlreadyAccepted {
            // ok
        }

        // Workspace row preserved exactly as pre-seeded; no new members added.
        let org = try XCTUnwrap(inviteeDB.readWorkspace(id: orgID))
        XCTAssertEqual(org.name, "Already Mine",
                       "Pre-seeded workspace row should be untouched")
        XCTAssertEqual(try inviteeDB.readTeamMembers(workspaceID: org.id).count, 0)
    }
