    private func stub201Counter(_ tokenPrefix: String) {
        let counter = Counter()
        HandshakeMockURLProtocol.handler = { req, _ in
            let n = counter.next()
            let body = """
            {"token":"\(tokenPrefix)\(n)","expires_at_ms":1700086400000}
            """.data(using: .utf8)!
            let resp = HTTPURLResponse(url: req.url!, statusCode: 201, httpVersion: nil,
                                       headerFields: ["Content-Type": "application/json"])!
            return (resp, body)
        }
    }

    private final class Counter: @unchecked Sendable {
        private var n = 0
        private let lock = NSLock()
        func next() -> Int {
            lock.lock(); defer { lock.unlock() }
            n += 1; return n
        }
    }

