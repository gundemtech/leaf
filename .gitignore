# Локальные настройки Claude Code — у каждого свои
.claude/settings.local.json
.claude/shared/drafts/
# Phase-execution планы — внутренние: ship timeline, trade-offs, moat boundaries
.claude/plans/
# Superpowers git worktrees — генерируются using-git-worktrees skill, локально
.claude/worktrees/
# Superpowers tactical plans — содержат полные Swift implementation блоки с moat-чувствительным контентом
# (regex patterns, tuned numeric thresholds, byte caps). Specs (API-only) — committed; plans — нет.
docs/superpowers/plans/

# Логи
excalidraw.log
*.log

# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.build-xcode/
.swiftpm/
Packages/*/Package.resolved
*.xcresult
# Workspace-level SPM state — user-specific (artifacts/, configuration/, etc.).
# Exception: Package.resolved для remote SPM deps (Sparkle и т.д.) — committed для reproducible builds.
# NB: git negation `!` НЕ работает если parent dir ignored, поэтому ignore'им только подпапки swiftpm/.
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/artifacts/

# LeafCorePrivate — implementation moat живёт локально.
# Tracked только Placeholder.swift; все остальные swift-файлы — dev-only.
Packages/LeafCore/Sources/LeafCorePrivate/**/*.swift
!Packages/LeafCore/Sources/LeafCorePrivate/Placeholder.swift

# LeafCorePrivateTests — тесты для moat-модуля (SQL assertions и т.п.).
# Tracked только Placeholder.swift, реальные тесты — dev-only.
Packages/LeafCore/Tests/LeafCorePrivateTests/**/*.swift
!Packages/LeafCore/Tests/LeafCorePrivateTests/Placeholder.swift

# Local xcconfig — dev-only флаги для LeafCorePrivate prod-сборки.
# Пример в Config/Local.xcconfig.example (tracked).
Config/Local.xcconfig

# Phase 3 distribution — secrets and release artifacts
*.p8
build/releases/
*eddsa-private*
*.eddsa
.envrc
.env

# Supabase CLI workspace cache (created when supabase CLI is run from leaf/)
supabase/
