<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>tech.gundem.leaf.agent</string>

	<!-- Path relative to the main app bundle.
	     SMAppService.agent(plistName:) resolves BundleProgram against the .app/. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/LeafAgent</string>

	<!-- Restart on crash, but NOT on normal exit (SIGTERM / user-triggered shutdown). -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- Background process: lower priority, no Dock interaction. -->
	<key>ProcessType</key>
	<string>Background</string>

	<!-- Dev-only logging к /tmp. Перед distribution (Phase 3) убрать. -->
	<key>StandardOutPath</key>
	<string>/tmp/tech.gundem.leaf.agent.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/tech.gundem.leaf.agent.stderr.log</string>
</dict>
</plist>
