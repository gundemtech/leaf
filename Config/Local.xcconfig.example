// Local.xcconfig.example — скопируй в Local.xcconfig (gitignored) если нужно
// что-то override'ить локально. Пустой dev-конфиг не нужен — Production.xcconfig
// уже содержит team-wide значения.

// Раскомментируй чтобы собрать с production moat-реализациями (SQL тела,
// точные пороги). Без этого флага — StubInsights + DatabaseConfig.weakDefaults.
// LEAF_FLAGS = LEAF_PROD

// Phase 4.1 — Linear OAuth client_id override для dev / staging. Production
// значение уже committed в Config/Production.xcconfig — обычным разработчикам
// override не нужен. Полезно если хочешь тестить со своим personal Linear
// OAuth app (например staging workspace, separate rate-limit bucket, etc.).
//
// LINEAR_OAUTH_CLIENT_ID = lin_oauth_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

// Phase 4.3 — GitHub OAuth client_id (Device Flow). Production placeholder в
// Production.xcconfig резолвится в литерал "$(...)", который GitHubOAuthService
// readClientID() трактует как "не сконфигурирован" и UI показывает actionable
// error. Создай свой OAuth App на https://github.com/settings/developers
// (Enable Device Flow = ON, Auth callback URL = http://localhost/unused) и
// раскомментируй:
//
// GITHUB_OAUTH_CLIENT_ID = Iv1.xxxxxxxxxxxxxxxx
