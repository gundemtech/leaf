// Base.xcconfig — общий для всех target-configuration.
// Пустой по умолчанию; всё тяжёлое сидит в project.pbxproj или per-target.
//
// Local.xcconfig (gitignored) переопределяет LEAF_FLAGS, чтобы
// включить компиляцию с production moat-реализациями.
// Скопируй Local.xcconfig.example → Local.xcconfig у себя и раскомментируй строку.

// Default: moat-флаг не установлен → StubInsights + DatabaseConfig.weakDefaults.
// CI билд (без Local.xcconfig) остаётся на этой ветке.
LEAF_FLAGS =

// Production.xcconfig (committed, team-wide public-safe values, e.g.
// LINEAR_OAUTH_CLIENT_ID). Загружаем до Local.xcconfig чтобы Local override'ил
// для dev / staging.
#include "Production.xcconfig"

// Local.xcconfig (gitignored, dev override). #include? — optional, не падаем
// если файл отсутствует (CI build).
#include? "Local.xcconfig"

// Каждый target в project.pbxproj делает:
//   SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(LEAF_FLAGS)
